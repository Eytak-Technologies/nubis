{
	"name": "@nubisjs/testing",
	"version": "0.1.0-next.0",
	"description": "Test Nubis commands, components and modals without Discord.",
	"license": "MIT",
	"author": "Eytak",
	"homepage": "https://eytak.com/nubis",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Eytak-Technologies/nubis.git",
		"directory": "packages/testing"
	},
	"bugs": "https://github.com/Eytak-Technologies/nubis/issues",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "bun build ./src/index.ts --outdir dist --target node --format esm --packages external && tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"test": "bun test",
		"lint": "biome lint ."
	},
	"dependencies": {
		"@nubisjs/core": "workspace:*",
		"discord-api-types": "^0.38.59"
	},
	"devDependencies": {
		"zod": "^4.6.7"
	}
}
