{
	"name": "nubis",
	"version": "0.1.0-next.3",
	"description": "The Discord bot framework that feels like building a modern web app. Built by Eytak.",
	"keywords": [
		"discord",
		"discord-bot",
		"framework",
		"nubis"
	],
	"license": "MIT",
	"author": "Eytak",
	"homepage": "https://eytak.com/nubis",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Eytak-Technologies/nubis.git",
		"directory": "packages/nubis"
	},
	"bugs": "https://github.com/Eytak-Technologies/nubis/issues",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"import": "./dist/testing.js"
		}
	},
	"bin": {
		"nubis": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "bun build ./src/index.ts ./src/node.ts ./src/testing.ts ./src/cli.ts --outdir dist --target node --format esm --packages external && tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"test": "bun test",
		"lint": "biome lint ."
	},
	"dependencies": {
		"@discordjs/core": "^2.7.0",
		"@discordjs/rest": "^2.6.3",
		"@discordjs/ws": "^2.0.4",
		"@nubisjs/core": "workspace:*",
		"@nubisjs/testing": "workspace:*",
		"discord-api-types": "^0.38.59"
	}
}
